# Fichier .env de PRODUCTION pour O2switch.
# Copiez-le sur le serveur sous le nom   ~/ecole-backend/.env   (à côté de manage.py, JAMAIS dans public_html),
# remplissez-le, puis :  chmod 600 ~/ecole-backend/.env
# Remplacez partout  ecole.exemple.ci  par votre adresse.

DEBUG=False

# Clé secrète : longue valeur aléatoire, propre à ce serveur (sur le serveur :  python3 -c "import secrets;print(secrets.token_urlsafe(60))")
SECRET_KEY=

# Adresse de l'API (sous-domaine de l'application Python)
ALLOWED_HOSTS=api.ecole.exemple.ci
# Adresse du site (là où se trouve l'interface Angular) : liens des e-mails, QR codes des bulletins et des reçus
PUBLIC_BASE_URL=https://ecole.exemple.ci
CORS_ALLOWED_ORIGINS=https://ecole.exemple.ci
CSRF_TRUSTED_ORIGINS=https://ecole.exemple.ci,https://api.ecole.exemple.ci

# Base PostgreSQL créée dans cPanel (« Bases de données PostgreSQL »). cPanel préfixe les noms par votre identifiant :
#   postgres://IDENTIFIANT_utilisateur:MOT_DE_PASSE@localhost:5432/IDENTIFIANT_base
# Un mot de passe contenant des caractères spéciaux (@ : / ? #) doit être encodé (ex. @ -> %40) ; plus simple : lettres et chiffres.
DATABASE_URL=postgres://IDENTIFIANT_ecole:MOT_DE_PASSE@localhost:5432/IDENTIFIANT_ecole

# Apache sert directement Django sur O2switch : aucun mandataire de confiance, X-Forwarded-For est ignoré.
NUM_PROXIES=0
# Cache partagé : table en base, créée par « migrate » (valeur par défaut, à laisser vide sauf besoin particulier)
# CACHE_URL=dbcache://ecole_cache

# Adresse secrète de l'administration Django (changez-la, terminez par /)
ADMIN_URL=gestion-ecole-x7/

# Durées de session et verrouillage après échecs
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Préfixe des matricules (HZ26-0001)
MATRICULE_PREFIX=HZ

# Mobile money : secret partagé avec l'opérateur. Le bac à sable DOIT rester à 0 (le serveur refuse de démarrer sinon).
MOBILE_MONEY_WEBHOOK_SECRET=
MOBILE_MONEY_SANDBOX=0

# E-mail : une boîte créée dans cPanel (« Comptes de messagerie »), ex. ne-pas-repondre@exemple.ci
# Port 587 + TLS uniquement (le port 465/SSL n'est pas géré par l'application).
EMAIL_HOST=mail.exemple.ci
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ne-pas-repondre@exemple.ci
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=École <ne-pas-repondre@exemple.ci>

# Alertes sur le téléphone : NOUVELLES clés, générées sur le serveur par   python manage.py generer_cles_push
# (ne réutilisez pas les clés de test de votre ordinateur)
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:contact@exemple.ci

LOG_LEVEL=INFO
HSTS_INCLUDE_SUBDOMAINS=False
