# Construit le site Angular puis le sert avec Caddy (contexte de build : le dossier parent contenant ecole-horizon et ecole-deploy).
FROM node:22-alpine AS build
WORKDIR /app
COPY ecole-horizon/package*.json ./
RUN npm ci
COPY ecole-horizon/ .
RUN npx ng build --configuration production

FROM caddy:2-alpine
COPY --from=build /app/dist/ecole-horizon/browser /srv
COPY ecole-deploy/Caddyfile /etc/caddy/Caddyfile
