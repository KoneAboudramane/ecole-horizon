# Copiez ce fichier en .env, remplissez, puis :  docker compose up -d --build
# Ne jamais publier le fichier .env.

# Nom de domaine du site (le DNS doit pointer vers le serveur ; Caddy obtient le certificat HTTPS tout seul)
DOMAIN=ecole.exemple.ci
# Plateforme à plusieurs écoles : laissez vide pour que chaque utilisateur saisisse le code de son école à la connexion.
# Déploiement dédié à une seule école (ex. un sous-domaine par école) : indiquez son code (ex. horizon).
ECOLE_CODE=

# Mot de passe de la base (longue valeur aléatoire :  openssl rand -base64 24)
POSTGRES_PASSWORD=

# Clé secrète Django (longue valeur aléatoire :  openssl rand -base64 64)
SECRET_KEY=

# Adresse de l'administration Django (changez-la, terminez par /)
ADMIN_URL=gestion-ecole-x7/

# Préfixe des matricules (HZ26-0001)
MATRICULE_PREFIX=HZ

# Mobile money : secret partagé avec l'opérateur pour signer les retours. Vide = paiements en ligne non confirmables.
MOBILE_MONEY_WEBHOOK_SECRET=

# E-mail (lien « mot de passe oublié » du personnel). Vide = aucun message ne part.
# Exemple Brevo : EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, identifiant et clé SMTP fournis par Brevo.
# Exemple Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, adresse + « mot de passe d'application » (validation en 2 étapes requise).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Alertes sur le téléphone des parents (gratuit). Générez les clés une seule fois :
#   docker compose run --rm web python manage.py generer_cles_push
# puis collez les deux lignes ici. Vide = alertes désactivées (les notifications restent dans l'application).
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
# Contact exigé par Google et Apple pour l'envoi des alertes (une vraie adresse, ex. mailto:contact@votre-domaine.ci)
WEBPUSH_SUBJECT=

# Sauvegardes : heure (0-23, fuseau du serveur) et nombre de jours conservés
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
