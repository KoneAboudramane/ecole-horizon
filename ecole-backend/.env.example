# Copiez ce fichier en .env puis adaptez les valeurs. Ne jamais publier le .env.
DEBUG=True
SECRET_KEY=changez-moi-par-une-longue-valeur-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite par défaut. En production : PostgreSQL
# DATABASE_URL=postgres://ecole:motdepasse@db:5432/ecole
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mobile money (production : secret long et aléatoire fourni avec l'opérateur ; sandbox toujours à 0)
MOBILE_MONEY_WEBHOOK_SECRET=
MOBILE_MONEY_SANDBOX=0

# ---- PRODUCTION (DEBUG=False) ----
# SECRET_KEY : longue valeur aléatoire (python -c "import secrets;print(secrets.token_urlsafe(60))")
# ADMIN_URL : chemin secret de l'administration Django, ex. gestion-x7k2/
ADMIN_URL=admin/
LOG_LEVEL=INFO
HSTS_INCLUDE_SUBDOMAINS=False
# En production, l'application refuse de démarrer si SECRET_KEY commence par "dev-only"
# ou si MOBILE_MONEY_SANDBOX est actif. Voir ../ecole-deploy/DEPLOIEMENT.md
